{
  "uid": "eea-9_sik",
  "title": "Alertmanager Advanced",
  "description": "Current-metrics Alertmanager operations dashboard. This cluster runs a single Alertmanager replica, so peer and gossip panels from the legacy HA dashboard were replaced with alert intake, delivery, silence, latency, config, and process health.",
  "tags": [
    "alerting",
    "alertmanager",
    "devsecops",
    "observability"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
