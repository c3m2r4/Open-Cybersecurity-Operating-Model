    "docker",
    "containers",
    "portainer",
    "grafana-dashboard-21743",
    "devsecops",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
