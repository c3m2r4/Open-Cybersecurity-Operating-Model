{
  "uid": "docker-containers-overview",
  "title": "Docker Containers Advanced",
  "description": "Docker host container operations dashboard adapted from Grafana Labs dashboard 21743 to the local docker_container_* metrics. Includes lifecycle, resource, network, block I/O, and inventory views.",
