        "definition": "label_values(docker_container_info, name)",
        "query": {
          "query": "label_values(docker_container_info, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
